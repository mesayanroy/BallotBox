{
  "name": "@midnight-ntwrk/private-polling-contract",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc --project tsconfig.build.json && node -e \"fs.cpSync('./src/managed', './dist/managed', {recursive: true}); fs.copyFileSync('./src/private-polling.compact', './dist/private-polling.compact')\"",
    "ci": "npm run typecheck && npm run lint && npm run build && npm run test -- --run",
    "compact": "node ../scripts/compact.mjs",
    "lint": "eslint src",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "license": "Apache-2.0",
  "author": "Satish Jalan"
}